                 settingsButton.addListener (settingsButtonListener);
 
+               #if JUCE_MAC
+                // R3WRK: the label mustn't eat clicks -- the banner is the only grab area at the
+                // top of the window (native title-bar strip is hidden), so mouseDown here starts
+                // a window move.
+                notification.setInterceptsMouseClicks (false, false);
+               #endif
+
                 addAndMakeVisible (notification);
                 addAndMakeVisible (settingsButton);
             }
 
+           #if JUCE_MAC
+            void mouseDown (const MouseEvent&) override   { r3wrkBeginWindowDrag (this); }
+           #endif
+
             void paint (Graphics& g) override
             {
                 auto r = getLocalBounds();
 
-                g.setColour (Colours::darkgoldenrod);
+                g.setColour (Colour (0xff5ec2ff));
