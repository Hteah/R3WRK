 };
 
+#if JUCE_MAC
+// R3WRK: a plain C bridge so the plugin editor can open the Audio/MIDI settings dialog from its
+// own menu -- it can't see StandalonePluginHolder directly (this header is only compiled into
+// juce_audio_plugin_client_Standalone.cpp). R3WRK weak-references this, so the VST3/AU targets
+// (which don't compile that TU) still link.
+extern "C" void r3wrkShowAudioSettings()
+{
+    if (auto* holder = StandalonePluginHolder::getInstance())
+        holder->showAudioSettingsDialog();
+}
+#endif
+
 } // namespace juce
