+                notification.setInterceptsMouseClicks (false, false);
+               #endif
+
                 addAndMakeVisible (notification);
                 addAndMakeVisible (settingsButton);
             }
 
+           #if JUCE_MAC
+            void mouseDown (const MouseEvent&) override   { r3wrkBeginWindowDrag (this); }
